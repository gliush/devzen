{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}{{- $pages = $pages | first $limit -}}{{- end -}}
{{- "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0"
  xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ .Site.Title }}</title>
  <link>{{ .Site.BaseURL }}</link>
  <description>{{ .Site.Params.podcast.itunesSummary }}</description>
  <language>{{ .Site.Language.Locale }}</language>
  <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
  {{ partial "head-itunes.html" . }}
  {{- range $pages }}
  {{- if .Params.audio_url }}
  <item>
    <title>{{ .Title | html }}</title>
    <link>{{ .Permalink }}</link>
    <guid isPermaLink="false">https://devzen.ru/?p={{ .Params.original_post_id }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ .Params.summary | html }}</description>
    <itunes:summary>{{ .Params.summary | html }}</itunes:summary>
    <itunes:author>{{ $.Site.Params.podcast.itunesAuthor }}</itunes:author>
    <itunes:explicit>no</itunes:explicit>
    {{- with .Params.audio_duration }}<itunes:duration>{{ . }}</itunes:duration>{{ end }}
    <enclosure url="{{ .Params.audio_url }}" length="{{ mul (.Params.audio_size_mb | default 0.0) 1048576 | int }}" type="audio/mpeg" />
  </item>
  {{- end }}
  {{- end }}
</channel>
</rss>
